<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.appbar.AppBarLayout android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/theme_toolbar" android:layout_width="match_parent" android:layout_height="?actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back" app:title="@string/theme_title" app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingBottom="32.0dp">

            <!-- Master enable switch -->
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="16.0dp" app:cardCornerRadius="20.0dp" app:cardElevation="0.0dp" app:strokeWidth="0.0dp" app:cardBackgroundColor="?colorSurfaceContainerLow">
                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="16.0dp">
                    <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
                        android:text="@string/theme_enable" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/theme_enable_switch"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Liquid Glass Navigation Bar (iOS 27) Section -->
            <LinearLayout android:id="@+id/theme_nav_header" android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20.0dp" android:paddingEnd="20.0dp"
                android:paddingTop="12.0dp" android:paddingBottom="8.0dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="22.0dp" android:layout_height="22.0dp" android:layout_marginEnd="12.0dp"
                    android:src="@drawable/ic_sparkle" app:tint="?colorPrimary" android:contentDescription="@null" />
                <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
                    android:text="@string/liquid_glass_section_title" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                <ImageView android:id="@+id/theme_nav_expand_icon" android:layout_width="24.0dp" android:layout_height="24.0dp"
                    android:src="@drawable/ic_expand_less" android:contentDescription="@string/theme_collapse_section" />
            </LinearLayout>

            <LinearLayout android:id="@+id/theme_nav_content" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">

                <!-- Nav bar enable switch card -->
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="16.0dp" android:layout_marginEnd="16.0dp" android:layout_marginBottom="12.0dp"
                    app:cardCornerRadius="20.0dp" app:cardElevation="0.0dp" app:strokeWidth="1.0dp" app:strokeColor="?colorOutlineVariant" app:cardBackgroundColor="?colorSurfaceContainerLow">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="16.0dp">
                        <LinearLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/liquid_glass_nav_bar" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dp" android:text="@string/liquid_glass_nav_bar_subtitle"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?colorOnSurfaceVariant" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/theme_nav_enable_switch"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- LIVE INTERACTIVE PREVIEW CARD -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/theme_nav_preview_card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="16.0dp" android:layout_marginEnd="16.0dp" android:layout_marginBottom="16.0dp"
                    app:cardCornerRadius="24.0dp" app:cardElevation="4.0dp" app:strokeWidth="1.2dp" app:strokeColor="#50818CF8"
                    app:cardBackgroundColor="?colorSurfaceContainer">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="14.0dp">

                        <!-- Preview Header Badge & Hint -->
                        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10.0dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/liquid_glass_preview_badge"
                                android:textStyle="bold" android:textSize="11.0sp"
                                android:textColor="#818CF8" android:paddingStart="8.0dp" android:paddingEnd="8.0dp"
                                android:paddingTop="3.0dp" android:paddingBottom="3.0dp"
                                android:background="@drawable/bg_version_chip" />
                            <TextView android:id="@+id/theme_nav_preview_tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginStart="8.0dp" android:text="@string/liquid_glass_preview_tag"
                                android:textSize="12.0sp" android:textStyle="bold" android:textColor="?colorPrimary" />
                            <View android:layout_width="0.0dp" android:layout_height="1.0dp" android:layout_weight="1.0" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="⚡ 60fps" android:textSize="11.0sp" android:textColor="?colorOutline" />
                        </LinearLayout>

                        <!-- Simulated Feed & Glass Nav Stage -->
                        <FrameLayout android:id="@+id/theme_nav_preview_stage" android:layout_width="match_parent" android:layout_height="175.0dp"
                            android:background="@drawable/bg_liquid_glass_preview" android:clipChildren="false" android:clipToPadding="false">

                            <!-- Simulated Instagram Post Background Elements -->
                            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:padding="12.0dp">
                                <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                                    android:layout_width="match_parent" android:layout_height="wrap_content">
                                    <View android:layout_width="28.0dp" android:layout_height="28.0dp"
                                        android:background="@drawable/bg_avatar_ring" />
                                    <LinearLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="wrap_content"
                                        android:layout_weight="1.0" android:layout_marginStart="8.0dp">
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                            android:text="instaeclipse_official" android:textColor="#E0E7FF"
                                            android:textSize="12.0sp" android:textStyle="bold" />
                                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                            android:text="Original Audio • Neon Dreams" android:textColor="#94A3B8"
                                            android:textSize="10.0sp" />
                                    </LinearLayout>
                                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                        android:text="•••" android:textColor="#E2E8F0" android:textSize="14.0sp" />
                                </LinearLayout>

                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="12.0dp" android:text="✨ iOS 27 Liquid Glass Fluid Dock"
                                    android:textColor="#F8FAFC" android:textSize="13.0sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2.0dp" android:text="❤️ 18.4K  💬 1,290  🚀 4.8K"
                                    android:textColor="#CBD5E1" android:textSize="11.0sp" />
                            </LinearLayout>

                            <!-- Live Slider Bar View inside Preview -->
                            <ps.reso.instaeclipse.mods.ui.LiquidGlassSliderBarView
                                android:id="@+id/theme_nav_preview_slider"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />
                        </FrameLayout>

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8.0dp" android:gravity="center"
                            android:text="@string/liquid_glass_preview_hint"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall" android:textColor="?colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Glass Style Picker Row Card -->
                <com.google.android.material.card.MaterialCardView android:id="@+id/theme_nav_style_card"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="16.0dp" android:layout_marginEnd="16.0dp" android:layout_marginBottom="12.0dp"
                    app:cardCornerRadius="18.0dp" app:cardElevation="0.0dp" app:strokeWidth="1.0dp" app:strokeColor="?colorOutlineVariant"
                    app:cardBackgroundColor="?colorSurfaceContainerLow" android:clickable="true" android:focusable="true">
                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16.0dp">
                        <ImageView android:layout_width="22.0dp" android:layout_height="22.0dp" android:layout_marginEnd="12.0dp"
                            android:src="@drawable/ic_palette" app:tint="?colorPrimary" android:contentDescription="@null" />
                        <LinearLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/liquid_glass_style" android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />
                            <TextView android:id="@+id/theme_nav_style_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="2.0dp" android:text="@string/liquid_glass_style_ios27"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textColor="?colorPrimary" android:textStyle="bold" />
                        </LinearLayout>
                        <ImageView android:layout_width="20.0dp" android:layout_height="20.0dp"
                            android:src="@drawable/ic_chevron_right" app:tint="?colorOutline" android:contentDescription="@null" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sliders Card: Opacity, Width Margin, Height, Corner Radius -->
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="16.0dp" android:layout_marginEnd="16.0dp" android:layout_marginBottom="12.0dp"
                    app:cardCornerRadius="20.0dp" app:cardElevation="0.0dp" app:strokeWidth="1.0dp" app:strokeColor="?colorOutlineVariant"
                    app:cardBackgroundColor="?colorSurfaceContainerLow">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="16.0dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/liquid_glass_options_card_title"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" android:textColor="?colorPrimary" />

                        <!-- 1. Opacity Slider -->
                        <TextView android:id="@+id/theme_nav_opacity_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14.0dp" android:text="Glass Opacity: 80%"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textStyle="bold" />
                        <SeekBar android:id="@+id/theme_nav_opacity_slider" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6.0dp" android:max="100" android:progress="80" />

                        <!-- 2. Side Margin (Width) Slider -->
                        <TextView android:id="@+id/theme_nav_margin_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14.0dp" android:text="Dock Side Margin: 14 dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textStyle="bold" />
                        <SeekBar android:id="@+id/theme_nav_margin_slider" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6.0dp" android:max="36" android:progress="14" />

                        <!-- 3. Dock Height Slider -->
                        <TextView android:id="@+id/theme_nav_height_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14.0dp" android:text="Dock Height: 56 dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textStyle="bold" />
                        <SeekBar android:id="@+id/theme_nav_height_slider" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6.0dp" android:max="20" android:progress="8" />

                        <!-- 4. Corner Radius Slider -->
                        <TextView android:id="@+id/theme_nav_radius_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="14.0dp" android:text="Corner Radius: 28 dp"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" android:textStyle="bold" />
                        <SeekBar android:id="@+id/theme_nav_radius_slider" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="6.0dp" android:max="26" android:progress="20" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Toggles Card: Sheen, FAB '+', Quick Actions -->
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="16.0dp" android:layout_marginEnd="16.0dp" android:layout_marginBottom="14.0dp"
                    app:cardCornerRadius="20.0dp" app:cardElevation="0.0dp" app:strokeWidth="1.0dp" app:strokeColor="?colorOutlineVariant"
                    app:cardBackgroundColor="?colorSurfaceContainerLow">
                    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="16.0dp">

                        <!-- Specular Rim Highlight -->
                        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
                                android:text="@string/liquid_glass_border_sheen" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/theme_nav_sheen_switch"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1.0dp"
                            android:layout_marginTop="10.0dp" android:layout_marginBottom="10.0dp" android:background="?colorOutlineVariant" />

                        <!-- Show '+' FAB Button -->
                        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
                                android:text="@string/liquid_glass_show_fab" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/theme_nav_fab_switch"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1.0dp"
                            android:layout_marginTop="10.0dp" android:layout_marginBottom="10.0dp" android:background="?colorOutlineVariant" />

                        <!-- Quick Actions Menu (iOS 27) -->
                        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_width="match_parent" android:layout_height="wrap_content">
                            <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
                                android:text="@string/liquid_glass_quick_actions" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
                            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/theme_nav_quick_actions_switch"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Reset Nav Bar Settings Button -->
                <com.google.android.material.button.MaterialButton android:id="@+id/theme_nav_reset"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginStart="16.0dp" android:layout_marginEnd="16.0dp" android:layout_marginBottom="16.0dp"
                    android:text="@string/liquid_glass_reset" style="@style/Widget.Material3.Button.TonalButton"
                    app:icon="@drawable/ic_delete" />
            </LinearLayout>

            <!-- Presets section -->
            <LinearLayout android:id="@+id/theme_presets_header" android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20.0dp" android:paddingEnd="20.0dp"
                android:paddingTop="8.0dp" android:paddingBottom="8.0dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
                    android:text="@string/theme_section_presets" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                <ImageView android:id="@+id/theme_presets_expand_icon" android:layout_width="24.0dp" android:layout_height="24.0dp"
                    android:src="@drawable/ic_expand_less" android:contentDescription="@string/theme_collapse_section" />
            </LinearLayout>
            <LinearLayout android:id="@+id/theme_presets_content" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/theme_preset_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="12.0dp" android:paddingEnd="12.0dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Custom colors section -->
            <LinearLayout android:id="@+id/theme_custom_header" android:orientation="horizontal" android:gravity="center_vertical"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20.0dp" android:paddingEnd="20.0dp"
                android:paddingTop="16.0dp" android:paddingBottom="8.0dp" android:background="?selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_weight="1.0"
                    android:text="@string/theme_section_custom" android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                <ImageView android:id="@+id/theme_custom_expand_icon" android:layout_width="24.0dp" android:layout_height="24.0dp"
                    android:src="@drawable/ic_expand_less" android:contentDescription="@string/theme_collapse_section" />
            </LinearLayout>
            <LinearLayout android:id="@+id/theme_custom_content" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/theme_color_slots" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="16.0dp" android:paddingEnd="16.0dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/theme_reset_custom" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_margin="16.0dp" android:text="@string/theme_reset_custom" style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
